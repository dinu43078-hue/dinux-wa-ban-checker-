<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B141A">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="D"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#07130D"
                android:background="@drawable/bg_logo_circle" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIN​​UX"
                    android:textColor="#25D366"
                    android:textStyle="bold"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WA BAN CHECKER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ONLINE"
                android:textColor="#25D366"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Check a number."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Enter an international phone number to view the API response."
            android:textColor="#AEBAC1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textColor="#25D366"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <EditText
                    android:id="@+id/countryCode"
                    android:layout_width="82dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="+94"
                    android:text="+94"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#71818A"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="8dp"
                    android:textSize="15sp" />
                <EditText
                    android:id="@+id/phoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Phone number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#71818A"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:paddingLeft="13dp"
                    android:paddingRight="10dp"
                    android:textSize="15sp" />
            </LinearLayout>
            <Button
                android:id="@+id/checkButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_green"
                android:text="CHECK NUMBER  →"
                android:textAllCaps="false"
                android:textColor="#062313"
                android:textStyle="bold"
                android:textSize="15sp" />
            <Button
                android:id="@+id/clearButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:text="Clear input"
                android:textAllCaps="false"
                android:textColor="#AEBAC1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card"
            android:visibility="gone">
            <TextView
                android:id="@+id/resultLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUMBER LOOKUP RESULT"
                android:textColor="#AEBAC1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/resultStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="ACTIVE"
                android:textColor="#25D366"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resultNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resultDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#AEBAC1"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/resultAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#AEBAC1"
                android:textSize="12sp" />
            <Button
                android:id="@+id/copyButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_darkgreen"
                android:text="COPY RESULT"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/historyButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_button_darkgreen"
                android:text="◷  History"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/aboutButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_darkgreen"
                android:text="ⓘ  About"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Unofficial API lookup • Not affiliated with WhatsApp\nDeveloped with ♥ by DINUX"
            android:textColor="#71818A"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
